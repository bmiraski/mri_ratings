+        {**base, "game_id": 2, "predicted": 25.0, "open": 10.0, "taken": 10.0, "edge": 15.0},        # it did not
+        {**base, "game_id": 3, "predicted": 12.0, "taken": 6.5, "edge": 5.5}]                        # an older pick with no opening line
