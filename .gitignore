__pycache__/
*.pyc
.pytest_cache/
*.duckdb
.env
shot-*.png

# Basketball box scores: 146MB of raw JSON, fetched only by the one-off Excel
# export and never read by the daily site build. The football raw cache is
# committed because the scheduled run depends on it; this one would more than
# double the repository to spare a manual script an API call. Re-fetches on
# demand.
data/raw/games_teams__*.json

# Basketball games feed for seasons before 2020-21, for the same reason one step
# removed. Nothing the daily build runs reads them: the MRI 2.0 chain warms up
# on 2019-20 and goes forward, and every older season is served from the derived
# Classic game log in data/parquet, which is 2MB for all of them against 125MB
# of JSON. The one-off archive scripts refetch on demand.
data/raw/games__*_season20[01][0-9]_*.json

# Basketball player, roster, recruiting and draft feeds: several megabytes each, read once to
# build the derived tables in data/parquet (a couple of megabytes for every season since 2010)
# and by the one live call for the season ahead. Re-fetches on demand.
data/raw/stats_player_season_*.json
data/raw/teams_roster_*.json
data/raw/recruiting_players_*.json
data/raw/draft_picks_*.json

# Football player-level feeds (stats by category, PPA, usage): megabytes each, seventeen seasons of
# them. Read once to build data/parquet/player_seasons.parquet; the current season is re-fetched by
# the weekly job. Re-fetches on demand.
data/raw/ppa_players_season_*.json
data/raw/player_usage_*.json
