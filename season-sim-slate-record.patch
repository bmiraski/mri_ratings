+def _pct(value, *, signed: bool = False) -> str:
+    """A probability as people read it: no false precision at either end."""
+    if value is None:
+        return "&ndash;"
+    v = float(value)
+    if signed:
+        points = v * 100
+        if abs(points) < 0.05:
+            return "0"
+        return f"{points:+.0f}" if abs(points) >= 10 else f"{points:+.1f}"
+    if v < 0.0005:
+        return "&lt;0.1%"
+    if v < 0.10:
+        return f"{v:.1%}"
+    if v > 0.995:
+        return "&gt;99%"
+    return f"{v:.0%}"
+
